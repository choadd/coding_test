{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "run current file",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}/run.ps1",
        "${file}"
      ],
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "clear": true },
      "problemMatcher": "$gcc"
    }
  ]
}
